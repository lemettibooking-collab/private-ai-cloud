import type { DevelopmentControllerState } from "../../lib/db/development-controller-store";
const live=await import(new URL("./helpers/live-pg.ts",import.meta.url).href) as typeof import("./helpers/live-pg");
const fixture=await import(new URL("../fixtures/roadmap.mts",import.meta.url).href) as typeof import("../fixtures/roadmap.mts");
const ownerModule=await import(new URL("../../lib/roadmap/roadmap-owner-commands.ts",import.meta.url).href) as typeof import("../../lib/roadmap/roadmap-owner-commands");
const approvalModule=await import(new URL("../../lib/db/roadmap-approvals.ts",import.meta.url).href) as typeof import("../../lib/db/roadmap-approvals");
const controllerStore=await import(new URL("../../lib/db/development-controller-store.ts",import.meta.url).href) as typeof import("../../lib/db/development-controller-store");
const db=await live.useLiveDatabase("controller_store"),f=await fixture.roadmapFixture(db,"controller-store");
const config={database:f.database,tenant:f.tenant},ownerConfig={...config,identitySource:f.identitySource},owner=ownerModule.createRoadmapOwnerCommands(ownerConfig),requests=approvalModule.createRoadmapApprovalRequests(config),decisions=approvalModule.createRoadmapOwnerApprovalDecisions(ownerConfig),store=controllerStore.createDevelopmentControllerStore(config);
await owner.createMilestone({commandId:"milestone-controller",projectId:"project-a",milestoneId:"milestone-controller",title:"Controller",goal:"Prove durability",priority:1});
let id=0;
const command=(state:DevelopmentControllerState,prefix="cmd")=>({commandId:`${prefix}-${++id}`,projectId:state.task.projectId,taskId:state.task.taskId,expectedVersion:state.task.version,expectedControllerRevision:state.revision});
async function setup(label:string,approved=true,providedPlan?:ReturnType<typeof fixture.roadmapPlan>){
  const plan=providedPlan??fixture.roadmapPlan();if(!providedPlan)plan.tasks[0].allowedPaths=[`lib/${label}/`];
  const task=await f.task(label,"feature",false);assert.equal((await f.planWriter.saveDraftRevision({idempotencyKey:`controller-plan-${label}-00000`,taskId:task.taskId,plan})).status,"created");
  assert.equal((await owner.enroll({commandId:`enroll-${label}`,projectId:task.projectId,taskId:task.taskId,expectedVersion:0,milestoneId:"milestone-controller",metadata:fixture.roadmapMetadata(),dependencyIds:[]})).status,"applied");
  assert.equal((await owner.changeState({commandId:`ready-${label}`,projectId:task.projectId,taskId:task.taskId,expectedVersion:1,nextStatus:"ready"})).status,"applied");
  let state=await store.read(task.projectId,task.taskId);assert.ok(state);assert.equal(state.revision,0);
  const claimed=await store.claimReady(command(state,"claim"));assert.equal(claimed.status,"applied",JSON.stringify(claimed));assert.ok(claimed.state);state=claimed.state;
  if(!approved)return state;
  const request=await requests.requestPlanApproval({...command(state,"request"),expectedControllerRevision:undefined});
  // Approval requests use the foundation command schema (no controller revision).
  assert.equal(request.status,"invalid_input");
  const base=command(state,"request-plan"),{expectedControllerRevision: omitted,...approvalCommand}=base;void omitted;
  const pending=await requests.requestPlanApproval(approvalCommand);assert.ok(pending.status==="applied",JSON.stringify(pending));
  const decision=await decisions.decide({...approvalCommand,commandId:`decision-${++id}`,approvalRequestId:pending.approvalRequestId,bindingFingerprint:pending.bindingFingerprint,decision:"approved"});assert.equal(decision.status,"applied",JSON.stringify(decision));
  const consumed=await store.consumePlanApproval({...command(state,"consume"),approvalRequestId:pending.approvalRequestId});assert.equal(consumed.status,"applied",JSON.stringify(consumed));assert.ok(consumed.state);return consumed.state;
}
const admission=(state:DevelopmentControllerState,taskId:string)=>({plan:state.approvedPlan!.plan,taskId,completedTaskIds:[],activeTaskIds:[],repositoryAllowlist:["lib"],taskOwnerApprovalGranted:true});
async function run(state:DevelopmentControllerState,label:string,taskId="step-1"){
  const r=await store.createRun({...command(state,"create"),developmentRunId:`run-${label}`,developmentTaskId:taskId,admission:admission(state,taskId)});assert.equal(r.status,"applied",JSON.stringify(r));assert.ok(r.state);return r.state;
}
async function reject(sql:string,params:unknown[]){try{await db.admin.query(sql,params);return false;}catch{return true;}}
test("controller claim+exact plan approval durable across fresh store restart",async()=>{const state=await setup("restart"),fresh=controllerStore.createDevelopmentControllerStore(config);assert.equal(state.task.status,"approved");assert.equal(state.approvedPlan?.plan.status,"approved");assert.deepEqual(await fresh.read(state.task.projectId,state.task.taskId),state);});
test("controller command replay before next-action selection returns exact original state",async()=>{const state=await setup("replay",false),c=command(state,"wait"),first=await store.changeTaskState({...c,nextStatus:"waiting_owner"});assert.equal(first.status,"applied");const replay=await store.replay(c);assert.equal(replay?.status,"replayed");assert.deepEqual(replay?.state,first.state);assert.equal((await store.replay({...c,expectedVersion:999}))?.status,"conflict");});
test("same commandId changed intent conflicts with no new revision",async()=>{const state=await setup("conflict",false),c=command(state,"same");assert.equal((await store.changeTaskState({...c,nextStatus:"waiting_owner"})).status,"applied");assert.equal((await store.changeTaskState({...c,nextStatus:"blocked"})).status,"conflict");assert.equal((await store.read(state.task.projectId,state.task.taskId))?.revision,state.revision+1);});
test("parallel controller state CAS permits exactly one transition",async()=>{const state=await setup("state-race",false),fresh=controllerStore.createDevelopmentControllerStore(config),c=command(state,"race");const d=await Promise.all([store.changeTaskState({...c,nextStatus:"waiting_owner"}),fresh.changeTaskState({...c,commandId:`other-${++id}`,nextStatus:"blocked"})]);assert.deepEqual(d.map(x=>x.status).sort(),["applied","conflict"]);});
test("createRun uses approved exact plan, persists canonical snapshot/history, starts parent running",async()=>{const state=await run(await setup("create"),"create");assert.equal(state.task.status,"running");assert.equal(state.runs.length,1);assert.equal(state.runs[0].revision,0);assert.equal(state.runs[0].run.status,"ready");const fresh=await controllerStore.createDevelopmentControllerStore(config).read(state.task.projectId,state.task.taskId);assert.deepEqual(fresh,state);});
test("two controllers cannot create/start the same DevelopmentTask twice",async()=>{const state=await setup("start-race"),c={...command(state,"create-race"),developmentRunId:"run-start-race",developmentTaskId:"step-1",admission:admission(state,"step-1")};const d=await Promise.all([store.createRun(c),store.createRun({...c,commandId:`other-${++id}`})]);assert.deepEqual(d.map(x=>x.status).sort(),["applied","conflict"]);const current=d.find(x=>x.status==="applied")!.state!;const start={...command(current,"start"),developmentRunId:"run-start-race",expectedRunRevision:0,event:{type:"start_attempt"}};const starts=await Promise.all([store.transitionRun(start),store.transitionRun({...start,commandId:`other-${++id}`})]);assert.deepEqual(starts.map(x=>x.status).sort(),["applied","conflict"]);});
test("run transition is accepted AI011 event, revision CAS/history survive restart",async()=>{const state=await run(await setup("run-transition"),"transition"),c={...command(state,"start"),developmentRunId:"run-transition",expectedRunRevision:0,event:{type:"start_attempt"}};const a=await store.transitionRun(c);assert.equal(a.status,"applied");assert.equal(a.state?.runs[0].run.status,"implementing");assert.equal(a.state?.runs[0].revision,1);const b=await store.transitionRun(c);assert.equal(b.status,"replayed");assert.deepEqual(a.state,b.state);assert.deepEqual(await store.read(state.task.projectId,state.task.taskId),a.state);});
test("caller cannot fabricate executor patch/failure or Quality/Security PASS",async()=>{let state=await run(await setup("forged-events"),"forged");const started=await store.transitionRun({...command(state),developmentRunId:"run-forged",expectedRunRevision:0,event:{type:"start_attempt"}});assert.ok(started.state);state=started.state;for(const event of [{type:"submit_patch",changedPaths:["lib/feature/a.ts"]},{type:"verification_passed",checks:[{command:"npm test",exitCode:0}]},{type:"review_passed"}])assert.equal((await store.transitionRun({...command(state),developmentRunId:"run-forged",expectedRunRevision:1,event})).status,"conflict");});
