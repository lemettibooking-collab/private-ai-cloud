test("same-plan independent disjoint wave nodes can create without duplicating scheduler",async()=>{const p=fixture.roadmapPlan();p.tasks.push({...p.tasks[0],id:"step-2",sequence:2,allowedPaths:["lib/independent/"]});const initial=await setup("independent",true,p),first=await run(initial,"independent-a"),second=await run(first,"independent-b","step-2");assert.equal(second.runs.length,2);});
