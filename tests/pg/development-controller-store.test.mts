test("missing/unapproved/stale exact plan prevents consumption",async()=>{const state=await setup("no-approval",false);assert.equal((await store.consumePlanApproval({...command(state),approvalRequestId:"00000000-0000-4000-8000-000000000099"})).status,"conflict");});
test("forged approved plan/admission payload never creates another plan/task",async()=>{const state=await setup("bad-admission"),a=admission(state,"step-1");assert.equal((await store.createRun({...command(state),developmentRunId:"run-bad",developmentTaskId:"step-1",admission:{...a,plan:{...a.plan,goal:"Injected goal"}}})).status,"conflict");assert.equal((await store.createRun({...command(state),developmentRunId:"run-other",developmentTaskId:"missing",admission:a})).status,"conflict");});
