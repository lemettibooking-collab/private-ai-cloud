test("lost controller COMMIT ACK reconciles historical state by command, no duplicate writes",async()=>{const state=await setup("ack",false),c={...command(state,"ack"),nextStatus:"waiting_owner"},i=live.installQueryInterceptor();let writes=0;i.observe(sql=>{if(sql.includes("/* controller:state-cas */"))writes++;});try{i.rules.push(live.rule("lost committed ACK",live.sqlTag("executor-transaction:commit"),async(_client,config,values,send)=>{await send(config,values);throw Error("simulated ACK loss");}));const d=await store.changeTaskState(c);assert.equal(d.status,"replayed");assert.equal(writes,1);assert.equal(d.state?.revision,state.revision+1);}finally{i.restore();}});
test("unknown controller COMMIT outcome remains recovery_required without retry",async()=>{const state=await setup("unknown",false),i=live.installQueryInterceptor();try{i.rules.push(live.rule("unknown ACK",live.sqlTag("executor-transaction:commit"),async()=>{throw Error("ambiguous connection");}));const d=await store.changeTaskState({...command(state,"unknown"),nextStatus:"waiting_owner"});assert.equal(d.status,"recovery_required");assert.equal((await store.read(state.task.projectId,state.task.taskId))?.revision,state.revision);}finally{i.restore();}});
test("hostile command getters/proxies rejected before any query",async()=>{let calls=0;const input={get commandId(){calls++;throw Error("private");}};assert.equal((await store.claimReady(input)).status,"invalid_input");assert.equal(calls,0);assert.equal((await store.claimReady(new Proxy({},{}))).status,"invalid_input");});
test("controller connection-class08 error destroys session after successful rollback",async()=>{const state=await setup("connection08",false),i=live.installQueryInterceptor(),monitor=live.installReuseMonitor();try{i.rules.push(live.rule("controller08",live.sqlTag("controller:state-cas"),async()=>{throw live.serverError("08006");}));assert.equal((await store.changeTaskState({...command(state),nextStatus:"waiting_owner"})).status,"unavailable");assert.ok(monitor.stats.destroyed>=1);assert.deepEqual(monitor.stats.violations,[]);}finally{monitor.restore();i.restore();}});
test("plan approval optional controller revision binds exact intent and rejects changed/stale revision",async()=>{
  const state=await setup("request-controller-revision",false),base=command(state,"request-ctrl"),a=await requests.requestPlanApproval(base);assert.equal(a.status,"applied");assert.equal((await requests.requestPlanApproval(base)).status,"replayed");
  assert.equal((await requests.requestPlanApproval({...base,expectedControllerRevision:base.expectedControllerRevision+1})).status,"conflict");
  assert.equal((await requests.requestPlanApproval({...base,commandId:`other-${++id}`,expectedControllerRevision:base.expectedControllerRevision+1})).status,"conflict");
  for(const value of [-1,1.5,NaN,"1",undefined])assert.equal((await requests.requestPlanApproval({...base,commandId:`invalid-${++id}`,expectedControllerRevision:value})).status,"invalid_input");
  const {expectedControllerRevision:ignored,...legacy}=base;void ignored;assert.equal((await requests.requestPlanApproval({...legacy,commandId:`legacy-${++id}`})).status,"applied","legacy foundation command schema remains supported");
  const count=(await db.admin.query(`select count(*)::int n from roadmap_approval_bindings where workspace_id=$1 and task_key=$2`,[f.workspaceId,state.task.taskId])).rows[0].n;assert.equal(count,1);
});
test("immutable controller readRevision is scoped, fresh/deeply frozen and issues no authority/write",async()=>{
  const before=await setup("historical-read",false),moved=await controllerStore.createDevelopmentControllerStore(config).changeTaskState({...command(before,"move"),nextStatus:"waiting_owner"});assert.equal(moved.status,"applied");
  const trace=live.installQueryInterceptor(),sql:string[]=[];trace.observe(value=>sql.push(value));let a:DevelopmentControllerState|null=null,b:DevelopmentControllerState|null=null;
  try{a=await store.readRevision(before.task.projectId,before.task.taskId,before.revision);b=await store.readRevision(before.task.projectId,before.task.taskId,before.revision);}finally{trace.restore();}
  assert.ok(a&&b);assert.deepEqual(a,b);assert.deepEqual(a,before);assert.notEqual(a,b);assert.notEqual(a.task,b.task);assert.notEqual(a.task.metadata,b.task.metadata);
  const frozen=(value:unknown):void=>{if(value&&typeof value==="object"){assert.ok(Object.isFrozen(value));for(const item of Object.values(value))frozen(item);}};frozen(a);frozen(b);
  assert.ok(sql.every(value=>!/(?:insert|update|delete|executor:authority|executor:controller)/iu.test(value)),"historical read only selects immutable event, no authority/persistence mutation");
  assert.equal(await store.readRevision("project-b",before.task.taskId,before.revision),null);assert.equal(await store.readRevision(before.task.projectId,before.task.taskId,99999),null);assert.equal(await store.readRevision(before.task.projectId,before.task.taskId,0),null);
  assert.equal((await store.read(before.task.projectId,before.task.taskId))?.task.status,"waiting_owner","historical replay never overwrites factual current state");
});
