test("direct SQL snapshot/version overwrite and history mutation rejected",async()=>{const state=await run(await setup("sql-run"),"sql-run");assert.ok(await reject(`update controller_development_runs set run_revision=run_revision+1 where workspace_id=$1 and development_run_id='run-sql-run'`,[f.workspaceId]));assert.ok(await reject(`update controller_development_events set event_json='{}' where workspace_id=$1 and development_run_id='run-sql-run'`,[f.workspaceId]));assert.ok(await reject(`update controller_project_tasks set controller_revision=controller_revision+1 where workspace_id=$1 and task_key=$2`,[f.workspaceId,state.task.taskId]));});
