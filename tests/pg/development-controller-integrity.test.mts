async function immediateCheck(sql:string,params:unknown[]){let error:Readonly<{code?:string;constraint?:string}>|null=null;await db.admin.query("begin");try{await db.admin.query(sql,params);}catch(e){error={code:(e as {code?:string}).code,constraint:(e as {constraint?:string}).constraint};}finally{await db.admin.query("rollback");}assert.equal(error?.code,"23514","statement must fail an immediate CHECK, not only a deferred missing journal");assert.ok(error?.constraint,"actual bounded/nullability DB CHECK identifies its constraint");}
