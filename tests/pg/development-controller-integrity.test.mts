test("direct SQL task approved/completed cannot gain authority from fabricated same-tx journal",async()=>{
  const t=await task("status-guard");let state=await store.read(t.projectId,t.taskId);assert.ok(state);const claimed=await store.claimReady({commandId:"claim-status",projectId:t.projectId,taskId:t.taskId,expectedVersion:state.task.version,expectedControllerRevision:state.revision});assert.ok(claimed.state);state=claimed.state;
  for(const next of ["approved","completed"]){await db.admin.query("begin");let denied=false;try{
    await db.admin.query(`update project_tasks set status=$3,state_version=state_version+1,completed_at=case when $3='completed' then now() end where workspace_id=$1 and task_key=$2`,[f.workspaceId,t.taskId,next]);
    const result={...state.task,status:next,version:state.task.version+1};
    await db.admin.query(`insert into roadmap_task_events(workspace_id,project_key,task_key,command_id,intent_fingerprint,previous_version,next_version,previous_status,next_status,event_kind,result_task) values($1,'project-a',$2,$3,repeat('a',64),$4,$4+1,'planning',$5,'state_changed',$6::jsonb)`,[f.workspaceId,t.taskId,`forged-${++n}`,state.task.version,next,JSON.stringify(result)]);
    await db.admin.query("commit");
  }catch{denied=true;await db.admin.query("rollback");}assert.equal(denied,true,"typed approval/completion DB guard rejects even an otherwise coherent task journal");}
});
