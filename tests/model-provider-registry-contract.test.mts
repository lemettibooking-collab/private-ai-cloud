test("messages missing only from Provider or Deployment fails closed", () => { const providerMissing = providerRegistry({ providers: [provider("provider-local", "local", ["forbidden"], { capabilities: [] })], deployments: [deployment("deployment-local", "provider-local", { capabilities: ["messages"] })], modelProfiles: [profile("model-shared", undefined, { requiredCapabilities: [] }), profile("model-one", undefined, { requiredCapabilities: [] })] }); const providerDecision = resolveModelInvocationRoute(routeInput("forbidden", providerMissing, [], "eu", [])); assert.equal(providerDecision.verdict, "deny"); assert.ok(codes(providerDecision).includes("capability_not_supported")); assert.equal(providerDecision.routePlan, null); const deploymentMissing = providerRegistry({ providers: [provider("provider-local", "local", ["forbidden"], { capabilities: ["messages"] })], deployments: [deployment("deployment-local", "provider-local", { capabilities: [] })], modelProfiles: [profile("model-shared", undefined, { requiredCapabilities: [] }), profile("model-one", undefined, { requiredCapabilities: [] })] }); const deploymentDecision = resolveModelInvocationRoute(routeInput("forbidden", deploymentMissing, [], "eu", [])); assert.equal(deploymentDecision.verdict, "deny"); assert.ok(codes(deploymentDecision).includes("capability_not_supported")); assert.ok(codes(deploymentDecision).includes("no_eligible_route")); assert.equal(deploymentDecision.routePlan, null); });
test("messages-compatible fallback becomes primary without mutating profile requirements", () => { const registry = providerRegistry({ providers: [provider("provider-a", "local", ["forbidden"], { capabilities: [] }), provider("provider-b", "local", ["forbidden"], { capabilities: ["messages"] })], deployments: [deployment("deployment-a", "provider-a", { capabilities: [] }), deployment("deployment-b", "provider-b", { capabilities: ["messages"] })], modelProfiles: [profile("model-shared", [{ deploymentId: "deployment-a", priority: 1 }, { deploymentId: "deployment-b", priority: 2 }], { requiredCapabilities: [] }), profile("model-one", [{ deploymentId: "deployment-b", priority: 1 }], { requiredCapabilities: [] })] }); const before = clone(registry); const decision = resolveModelInvocationRoute(routeInput("forbidden", registry, [], "eu", [])); assert.equal(decision.verdict, "allow", JSON.stringify(decision.reasons)); assert.equal(decision.routePlan?.primary.deploymentId, "deployment-b"); assert.deepEqual(registry, before); assert.deepEqual((registry.modelProfiles[0] as any).requiredCapabilities, []); });
test("redacted and approved remote routes carry planning requirements", () => { for (const [egress, requirement] of [["redacted_only", "redaction_required"], ["approved_minimum", "approval_required"]] as const) { const registry = providerRegistry({ providers: [provider("provider-remote", "remote", ["redacted_only", "approved_minimum"])], deployments: [deployment("deployment-remote", "provider-remote")], modelProfiles: [profile("model-shared", [{ deploymentId: "deployment-remote", priority: 1 }]), profile("model-one", [{ deploymentId: "deployment-remote", priority: 1 }])] }); const decision = resolveModelInvocationRoute(routeInput(egress, registry)); assert.equal(decision.verdict, "allow", JSON.stringify(decision.reasons)); assert.equal(decision.routePlan?.primary.dataHandlingRequirement, requirement); } });
test("remote candidate cannot route forbidden Project data", () => { const registry = providerRegistry({ providers: [provider("provider-remote", "remote", ["redacted_only", "approved_minimum"])], deployments: [deployment("deployment-remote", "provider-remote")], modelProfiles: [profile("model-shared", [{ deploymentId: "deployment-remote", priority: 1 }]), profile("model-one", [{ deploymentId: "deployment-remote", priority: 1 }])] }); const decision = resolveModelInvocationRoute(routeInput("forbidden", registry)); assert.equal(decision.verdict, "deny"); assert.equal(decision.routePlan, null); assert.ok(codes(decision).includes("data_egress_not_supported")); assert.ok(codes(decision).includes("no_eligible_route")); });
