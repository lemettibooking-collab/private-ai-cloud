test("all unavailable candidates deny with no partial route", () => { const registry = providerRegistry({ providers: [provider("provider-local", "local", ["forbidden"], { status: "paused" })] }); const decision = resolveModelInvocationRoute(routeInput("forbidden", registry)); assert.equal(decision.verdict, "deny"); assert.equal(decision.routePlan, null); assert.ok(codes(decision).includes("provider_inactive")); assert.ok(codes(decision).includes("no_eligible_route")); });
test("region, tools, and output capability checks are factual and fail closed", () => { const region = projectRegistry() as any; region.projects[0].projectManifest.dataRegion = "us"; const regionInput = routeInput() as any; regionInput.projectRegistry = region; assert.ok(codes(resolveModelInvocationRoute(regionInput)).includes("region_not_supported")); const noTools = providerRegistry({ providers: [provider("provider-local", "local", ["forbidden"], { capabilities: ["messages", "structured_output"] })], deployments: [deployment("deployment-local", "provider-local", { capabilities: ["messages", "structured_output"] })], modelProfiles: [profile("model-shared", [{ deploymentId: "deployment-local", priority: 1 }], { requiredCapabilities: ["messages"] }), profile("model-one", [{ deploymentId: "deployment-local", priority: 1 }], { requiredCapabilities: ["messages"] })] }); assert.ok(codes(resolveModelInvocationRoute(routeInput("forbidden", noTools))).includes("tools_not_supported")); });
