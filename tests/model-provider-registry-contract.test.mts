test("real AI-022 idempotent admission resolves and preserves the factual request", () => { const snapshot = runningSnapshot(); const first = evaluateModelInvocationAdmission({ snapshot, draft: draft(), existingRequests: [] }); assert.equal(first.verdict, "allow"); assert.ok(first.normalizedRequest); const input = { projectRegistry: projectRegistry(), modelProviderRegistry: providerRegistry(), invocationAdmission: { snapshot, draft: draft(), existingRequests: [first.normalizedRequest] } }; const decision = resolveModelInvocationRoute(input); assert.equal(decision.verdict, "allow", JSON.stringify(decision.reasons)); assert.equal(decision.invocationAdmissionDecision?.verdict, "idempotent"); assert.equal(decision.routePlan?.invocationId, first.normalizedRequest.invocationId); });
test("real AI-022 deny wins before provider registry validation and leaves no partial outputs", () => { const decision = resolveModelInvocationRoute({ projectRegistry: projectRegistry(), modelProviderRegistry: {}, invocationAdmission: { snapshot: runningSnapshot(), draft: { ...draft(), stepId: "missing-step" }, existingRequests: [] } }); assert.deepEqual(codes(decision), ["invalid_invocation_admission"]); assert.equal(decision.invocationAdmissionDecision?.verdict, "deny"); assert.equal(decision.normalizedRegistry, null); assert.equal(decision.routePlan, null); });
test("exact inactive modelProfile never falls back by provider kind or another profile", () => { const registry = providerRegistry(); (registry.modelProfiles[0] as any).status = "paused"; const decision = resolveModelInvocationRoute(routeInput("forbidden", registry)); assert.equal(decision.verdict, "deny"); assert.ok(codes(decision).includes("model_profile_inactive")); assert.equal(decision.routePlan, null); });
test("route resolution is repeated deterministic, reverse-order invariant, fresh, and deeply frozen", () => { const registry = providerRegistry({ providers: [provider("provider-a"), provider("provider-b")], deployments: [deployment("deployment-a", "provider-a"), deployment("deployment-b", "provider-b")], modelProfiles: [profile("model-shared", [{ deploymentId: "deployment-b", priority: 2 }, { deploymentId: "deployment-a", priority: 1 }]), profile("model-one", [{ deploymentId: "deployment-a", priority: 1 }])] }); const input = routeInput("forbidden", registry); const first = resolveModelInvocationRoute(input); const second = resolveModelInvocationRoute(input); assert.deepEqual(second, first); assert.notEqual(second.routePlan, first.routePlan); const reversed = clone(registry) as any; reversed.providers.reverse(); reversed.deployments.reverse(); reversed.modelProfiles.reverse(); for (const item of reversed.modelProfiles) item.candidates.reverse(); assert.deepEqual(resolveModelInvocationRoute(routeInput("forbidden", reversed)), first); assert.equal(deeplyFrozen(first), true); });
test("route envelope rejects accessors, cycles, Set, sparse arrays, and absolute depth without throw", () => { const values: unknown[] = []; const accessor = { projectRegistry: projectRegistry(), modelProviderRegistry: providerRegistry() }; Object.defineProperty(accessor, "invocationAdmission", { enumerable: true, get() { throw new Error("no"); } }); values.push(accessor); const cycle: any = routeInput(); cycle.loop = cycle; values.push(cycle, new Set(), { projectRegistry: projectRegistry(), modelProviderRegistry: providerRegistry(), invocationAdmission: { snapshot: runningSnapshot(), draft: draft(), existingRequests: Array(2) } }); let deep: any = {}; const root = deep; for (let index = 0; index < modelProviderRegistryLimits.maxEnvelopeDepth + 2; index += 1) { deep.next = {}; deep = deep.next; } values.push(root); for (const value of values) { assert.doesNotThrow(() => resolveModelInvocationRoute(value)); const decision = resolveModelInvocationRoute(value); assert.equal(decision.verdict, "deny"); assert.equal(decision.routePlan, null); } });
