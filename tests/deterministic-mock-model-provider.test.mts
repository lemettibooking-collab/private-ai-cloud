test("factory rejects getters, proxies, cycles, functions, and non-data config", () => { const getter = config(); Object.defineProperty(getter, "identity", { enumerable: true, get() { throw new Error("no read"); } }); const proxy = new Proxy({}, { ownKeys() { throw new Error("trap"); } }); const cycle: any = config(); cycle.self = cycle; for (const value of [getter, proxy, cycle, { ...config(), run: () => null }, new Set(), new Map(), new Date(), /x/u]) { assert.doesNotThrow(() => createDeterministicMockModelProvider(value)); const decision = createDeterministicMockModelProvider(value); assert.equal(decision.verdict, "deny"); assert.equal(decision.provider, null); assert.equal(decision.normalizedConfig, null); } });
