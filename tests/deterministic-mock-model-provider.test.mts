test("allowed tool proposal is returned but never executed", async () => { const request = factualRequest(); const proposal = result(request, { finishReason: "tool_calls", outputText: null, toolCallProposals: [{ toolCallId: "call-one", toolId: "tool-read", arguments: { path: "src" } }] }); const factory = createDeterministicMockModelProvider(config([{ request, result: proposal }])); assert.ok(factory.provider); const decision = await factory.provider.run(request); assert.equal(decision.verdict, "allow"); assert.equal(decision.normalizedResult?.toolCallProposals[0]?.toolId, "tool-read"); });

