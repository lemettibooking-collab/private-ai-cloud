test("factory requires mock identity and exact health identity", () => { assert.deepEqual(codes(createDeterministicMockModelProvider(config(undefined, { identity: identity({ providerKind: "local" }) }))), ["identity_not_mock"]); for (const [field, value] of [["providerId", "provider-other"], ["deploymentId", "deployment-other"]] as const) { const decision = createDeterministicMockModelProvider(config(undefined, { health: health("healthy", { [field]: value }) })); assert.deepEqual(codes(decision), ["health_identity_mismatch"]); assert.equal(decision.reasons[0]?.path, `health.${field}`); } });
test("reverse script order normalizes canonically and does not change factual runs", async () => { const one = factualRequest(); const two = { ...clone(one), invocationId: "invocation-two", invocationSequence: 2 }; const scripts = [{ request: two, result: result(two) }, { request: one, result: result(one) }]; const forward = createDeterministicMockModelProvider(config(scripts)); const reverse = createDeterministicMockModelProvider(config([...scripts].reverse())); assert.equal(forward.verdict, "allow"); assert.deepEqual(reverse.normalizedConfig, forward.normalizedConfig); assert.deepEqual(reverse.reasons, forward.reasons); assert.ok(forward.provider && reverse.provider); assert.deepEqual(await reverse.provider.run(one), await forward.provider.run(one)); });
test("reason count is capped", () => { const scripts = Array.from({ length: mockModelProviderLimits.maxScripts }, (_, index) => ({ request: { invalid: index }, result: { invalid: index } })); const decision = createDeterministicMockModelProvider(config(scripts)); assert.ok(decision.reasons.length <= modelProviderAdapterLimits.maxReasons); assert.equal(decision.provider, null); });
test("factory and provider retain no caller references", async () => { const request = factualRequest(); const input = config([{ request, result: result(request) }]); const before = clone(input); const factory = createDeterministicMockModelProvider(input); assert.ok(factory.provider && factory.normalizedConfig); assert.deepEqual(input, before); assert.notEqual(factory.normalizedConfig, input); const runInput = clone(request); const runBefore = clone(runInput); await factory.provider.run(runInput); assert.deepEqual(runInput, runBefore); });
