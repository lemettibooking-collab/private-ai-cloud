test("factory builds a provider from a real AI-021/AI-022 factual request", () => { const request = factualRequest(); assert.equal(request.runId, "run-one"); assert.equal(request.stepId, "execute-one"); assert.deepEqual(request.toolIds, ["tool-read"]); const input = config([{ request, result: result(request) }]); const before = clone(input); const decision = createDeterministicMockModelProvider(input); assert.equal(decision.verdict, "allow", JSON.stringify(decision.reasons)); assert.ok(decision.provider); assert.ok(decision.normalizedConfig); assert.equal(decision.provider.identity.providerKind, "mock"); assert.equal(deeplyFrozen(decision.normalizedConfig), true); assert.deepEqual(input, before); });
test("valid success script returns deterministic fresh deeply frozen results", async () => { const request = factualRequest(); const factory = createDeterministicMockModelProvider(config([{ request, result: result(request) }])); assert.ok(factory.provider); const first = await factory.provider.run(request); const second = await factory.provider.run(request); assert.equal(first.verdict, "allow", JSON.stringify(first.reasons)); assert.deepEqual(first, second); assert.notEqual(first, second); assert.notEqual(first.normalizedResult, second.normalizedResult); assert.equal(deeplyFrozen(first), true); });
test("valid failed provider error script is returned as factual normalized result", async () => { const request = factualRequest(); const failed = result(request, { outcome: "failed", finishReason: "error", outputText: null, error: { category: "provider_error", code: "mock-failure", message: "Deterministic failure.", retryable: false } }); const factory = createDeterministicMockModelProvider(config([{ request, result: failed }])); assert.ok(factory.provider); const decision = await factory.provider.run(request); assert.equal(decision.verdict, "allow"); assert.equal(decision.normalizedResult?.outcome, "failed"); });
