import assert from "node:assert/strict";
import { test } from "node:test";
const r=await import(new URL("../lib/roadmap/roadmap-contract.ts",import.meta.url).href) as typeof import("../lib/roadmap/roadmap-contract");
const f=await import(new URL("./fixtures/roadmap.mts",import.meta.url).href) as typeof import("./fixtures/roadmap.mts");
const revisions=await import(new URL("../lib/development/feature-plan-revision.ts",import.meta.url).href) as typeof import("../lib/development/feature-plan-revision");
const node=(taskId:string,status="ready",dependencyIds:string[]=[],priority="P1")=>({taskId,status:status as import("../lib/tasks/project-task").ProjectTaskStatus,dependencyIds,priority});
for(const [type,expected] of [["feature","implementation"],["fix","repair"],["investigation","analysis"],["roadmap","analysis"]] as const){
  test(`task class derives ${type} → ${expected}`,()=>{assert.equal(r.deriveRoadmapTaskClass(type,false),expected);assert.equal(r.deriveRoadmapTaskClass(type,true),"repair");});
}
test("task class rejects caller injection/unknown runtime values even on correction",()=>{for(const v of ["refactor","verification","openai",null,{},undefined])assert.throws(()=>r.deriveRoadmapTaskClass(v as never,true));assert.throws(()=>r.deriveRoadmapTaskClass("feature",1 as never));});
test("bounded metadata canonical fresh frozen, no input mutation",()=>{const input=f.roadmapMetadata();input.scope=["Z","A","A"];const before=structuredClone(input);const a=r.normalizeRoadmapMetadata(input),b=r.normalizeRoadmapMetadata(input);assert.ok(a&&b);assert.deepEqual(a,b);assert.notEqual(a,b);assert.deepEqual(a.scope,["A","Z"]);assert.ok(Object.isFrozen(a.scope));assert.deepEqual(input,before);});
test("metadata rejects hostile proxies/getters without invoking them",()=>{let calls=0;const getter={...f.roadmapMetadata(),get scope(){calls++;throw Error("private");}};assert.equal(r.normalizeRoadmapMetadata(getter),null);assert.equal(calls,0);assert.equal(r.normalizeRoadmapMetadata(new Proxy(f.roadmapMetadata(),{ownKeys(){throw Error("private");}})),null);});
test("metadata rejects missing gates, secretlike/oversized/unknown fields",()=>{for(const patch of [{requiredQuality:false},{requiredSecurity:false},{approvalPolicy:"auto"},{scope:["sk-abcdefghijk"]},{artifacts:Array(33).fill("artifact")},{changeEvidence:"x".repeat(1001)},{taskClass:"implementation"}])assert.equal(r.normalizeRoadmapMetadata({...f.roadmapMetadata(),...patch}),null);});
test("dependency graph accepts stable DAG and rejects cycle/self/missing/duplicate",()=>{const good=[node("b","ready",["a"]),node("a","completed")];assert.equal(r.validateRoadmapGraph(good),true);for(const nodes of [[node("a","ready",["b"]),node("b","ready",["a"])],[node("a","ready",["a"])],[node("a","ready",["missing"])],[node("a"),node("a")]])assert.equal(r.validateRoadmapGraph(nodes),false);});
test("readiness requires completed dependency and active project/milestone",()=>{for(const status of ["ready","running","failed","recovery_required","waiting_owner"]){const d=r.planRoadmapReadiness([node("a",status),node("b","ready",["a"])],true,true);assert.ok(d);assert.ok(!d.ready.includes("b"));}assert.deepEqual(r.planRoadmapReadiness([node("a","completed"),node("b","ready",["a"])],true,true)?.ready,["b"]);assert.deepEqual(r.planRoadmapReadiness([node("b")],false,true)?.ready,[]);assert.deepEqual(r.planRoadmapReadiness([node("b")],true,false)?.ready,[]);});
test("planner deterministic reverse inputs, priorities, no mutations",()=>{const input=[node("b","ready",[],"P2"),node("a","ready",[],"P1")],before=structuredClone(input);assert.deepEqual(r.planRoadmapReadiness(input,true,true),r.planRoadmapReadiness([...input].reverse(),true,true));assert.deepEqual(input,before);assert.deepEqual(r.planRoadmapReadiness(input,true,true)?.ready,["a","b"]);});
test("planner rejects every hostile array boundary without getters",()=>{let calls=0;const getter={get taskId():string{calls++;throw Error("secret");},status:"ready" as const,dependencyIds:[],priority:"P1"};assert.equal(r.planRoadmapReadiness([getter],true,true),null);const sparse=Array(1);assert.equal(r.planRoadmapReadiness(sparse,true,true),null);const extra=Object.assign([node("a")],{extra:1});assert.equal(r.planRoadmapReadiness(extra,true,true),null);assert.equal(r.planRoadmapReadiness(new Proxy([node("a")],{}),true,true),null);assert.equal(calls,0);assert.equal(r.planRoadmapReadiness([node("a","ready",[],"unknown")],true,true),null);});
test("canonical fingerprint rejects arbitrary hostile unknown and bounds work",()=>{assert.equal(r.roadmapFingerprint({b:2,a:1}),r.roadmapFingerprint({a:1,b:2}));let invoked=0;assert.throws(()=>r.roadmapFingerprint({get value(){invoked++;throw Error("secret");}}));assert.equal(invoked,0);assert.throws(()=>r.roadmapFingerprint(new Proxy({},{})));assert.throws(()=>r.roadmapFingerprint(Array(4097).fill(0)));let deep:unknown={};for(let i=0;i<30;i++)deep={deep};assert.throws(()=>r.roadmapFingerprint(deep));});
test("approved execution plan materializes exact immutable draft only",()=>{const raw=revisions.normalizeDraftPlan(f.roadmapPlan(),"plan-00000000000000000001");assert.ok(raw.ok);const before=structuredClone(raw.plan),fingerprint=revisions.featurePlanFingerprint(raw.plan);const a=r.materializeApprovedRoadmapPlan(raw.plan,raw.plan.id,fingerprint),b=r.materializeApprovedRoadmapPlan(raw.plan,raw.plan.id,fingerprint);assert.ok(a&&b);assert.equal(a.plan.status,"approved");assert.equal(a.draft.status,"draft");assert.deepEqual(a,b);assert.notEqual(a.plan,b.plan);assert.ok(Object.isFrozen(a.plan.tasks[0].allowedPaths));assert.deepEqual(raw.plan,before);assert.equal(r.materializeApprovedRoadmapPlan(raw.plan,raw.plan.id,"0".repeat(64)),null);});
test("status transition policy arrays cannot be mutated",()=>{assert.ok(Object.isFrozen(r.roadmapTaskTransitions.ready));assert.throws(()=> (r.roadmapTaskTransitions.ready as string[]).push("completed"));assert.ok(!r.roadmapTaskTransitions.running.includes("completed"));});
test("fingerprint hostile huge key/symbol/toJSON/deep accessors stay bounded",()=>{assert.throws(()=>r.roadmapFingerprint({["k".repeat(1048577)]:1}));assert.throws(()=>r.roadmapFingerprint({[Symbol("key")]:1}));let calls=0;assert.throws(()=>r.roadmapFingerprint({toJSON(){calls++;return {};}}));assert.equal(calls,0);});
