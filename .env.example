# App
APP_ENV=development
APP_DEMO_WORKSPACE_SLUG=smart-algorithms-demo
APP_DEMO_USER_EMAIL=owner@smartalgorithms.local

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/private_ai_cloud_dev

# Future storage / AI / integrations
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

VECTOR_DB_URL=

LLM_PROVIDER=
LLM_API_KEY=

# AI-039.1 AI FeaturePlan planning (server-side only; the planner stays unavailable unless ALL are valid).
# Prices must be verified by the Owner against the provider's current pricing (USD micros per 1M tokens).
OPENAI_API_KEY=
PAC_PLANNER_PROVIDER=
PAC_PLANNER_MODEL_ID=
PAC_PLANNER_REQUEST_MODEL_ID=
PAC_PLANNER_MODEL_VERSION=
PAC_PLANNER_INPUT_PRICE_USD_MICROS_PER_MILLION=
PAC_PLANNER_OUTPUT_PRICE_USD_MICROS_PER_MILLION=
PAC_PLANNER_PRICES_VERIFIED_ON=
PAC_PLANNER_MAX_INPUT_TOKENS=
PAC_PLANNER_MAX_OUTPUT_TOKENS=
PAC_PLANNER_MAX_COST_USD_MICROS=
PAC_PLANNER_DAILY_TOKEN_BUDGET=
PAC_PLANNER_MONTHLY_COST_BUDGET_USD_CENTS=

INTERNAL_API_TOKEN=

# AI-039.2 Sign in with ChatGPT (plan access). Not secrets. The OAuth callback is
# http://127.0.0.1:<PAC_CHATGPT_CALLBACK_PORT>/integrations/chatgpt/callback (default port 3000).
# ChatGPT OAuth credentials are NEVER put in .env: they live in the protected local store
# (default ~/.config/private-ai-cloud/chatgpt).
PAC_CHATGPT_CALLBACK_PORT=
PAC_CHATGPT_CREDENTIAL_DIR=
