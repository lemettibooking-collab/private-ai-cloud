{
  "name": "private-ai-cloud",
  "services": {
    "app": {
      "image": "private-ai-cloud:ai045-local",
      "build": { "context": ".", "target": "runtime" },
      "user": "1000:1000",
      "init": true,
      "restart": "unless-stopped",
      "ports": ["127.0.0.1:3000:3000"],
      "environment": {
        "NODE_ENV": "production",
        "NEXT_TELEMETRY_DISABLED": "1",
        "DATABASE_URL": "${DATABASE_URL:?Set DATABASE_URL in the protected runtime env}",
        "AUTH_SECRET": "${AUTH_SECRET:?Set AUTH_SECRET in the protected runtime env}",
        "AUTH_GITHUB_ID": "${AUTH_GITHUB_ID:?Set AUTH_GITHUB_ID in the protected runtime env}",
        "AUTH_GITHUB_SECRET": "${AUTH_GITHUB_SECRET:?Set AUTH_GITHUB_SECRET in the protected runtime env}",
        "AUTH_URL": "http://127.0.0.1:3000",
        "APP_DEMO_WORKSPACE_SLUG": "${APP_DEMO_WORKSPACE_SLUG:?Set the factual workspace slug}"
      },
      "depends_on": { "postgres": { "condition": "service_healthy" } },
      "networks": ["application", "egress"],
      "volumes": [
        "pac_config:/home/node/.config/private-ai-cloud",
        "next_cache:/app/.next/cache"
      ],
      "read_only": true,
      "tmpfs": ["/tmp:rw,noexec,nosuid,size=64m,mode=1777"],
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "mem_limit": "1536m",
      "cpus": 1.25,
      "pids_limit": 256,
      "stop_grace_period": "30s",
      "logging": { "driver": "json-file", "options": { "max-size": "10m", "max-file": "3" } },
      "healthcheck": {
        "test": ["CMD", "node", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "scripts/deployment/health.mts", "ready"],
        "interval": "30s", "timeout": "10s", "start_period": "60s", "retries": 3
      }
    },
    "postgres": {
      "image": "postgres:16.15-bookworm",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "private_ai_cloud",
        "POSTGRES_USER": "pac",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?Set a strong unique runtime database password}",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256"
      },
      "volumes": ["postgres_data:/var/lib/postgresql/data"],
      "networks": ["application"],
      "security_opt": ["no-new-privileges:true"],
      "mem_limit": "768m",
      "cpus": 0.75,
      "pids_limit": 128,
      "shm_size": "128m",
      "stop_grace_period": "60s",
      "logging": { "driver": "json-file", "options": { "max-size": "10m", "max-file": "3" } },
      "healthcheck": {
        "test": ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U pac -d private_ai_cloud >/dev/null 2>&1"],
        "interval": "10s", "timeout": "5s", "start_period": "20s", "retries": 5
      }
    }
  },
  "networks": {
    "application": { "internal": true },
    "egress": { "driver": "bridge" }
  },
  "volumes": { "postgres_data": {}, "pac_config": {}, "next_cache": {} }
}
