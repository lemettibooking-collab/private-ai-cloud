# PLACEHOLDERS ONLY. Install outside the repository as /etc/private-ai-cloud/runtime.env.
# Owner-controlled file, chmod 600; never paste docker compose config output into reports.
# Generate a unique strong password; URL-encode it when constructing DATABASE_URL.
POSTGRES_PASSWORD=
# postgresql://pac:<URL-encoded runtime password>@postgres:5432/private_ai_cloud
DATABASE_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Actual domain workspace slug provisioned in PostgreSQL; does not grant Owner membership.
APP_DEMO_WORKSPACE_SLUG=
# No OPENAI_API_KEY. Existing protected local credential stores are preserved in pac_config.
# No planning, executor, provider-smoke or generic dispatch enablement is configured here.
